{
  "name": "safeship",
  "version": "0.1.0",
  "description": "Security scanner for vibe-coded projects. Finds leaked credentials, known-vulnerable dependencies, insecure configuration, and injection bugs in AI-generated Python and JavaScript.",
  "author": "Rishabh (@RishabhRao11)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RishabhRao11/safeship.git"
  },
  "homepage": "https://github.com/RishabhRao11/safeship#readme",
  "bugs": {
    "url": "https://github.com/RishabhRao11/safeship/issues"
  },
  "keywords": [
    "security",
    "scanner",
    "sast",
    "secrets",
    "cve",
    "semgrep",
    "nextjs",
    "express",
    "vibecoding"
  ],
  "bin": {
    "safeship": "bin/safeship.js"
  },
  "engines": {
    "node": ">=16"
  },
  "files": [
    "LICENSE",
    "bin/",
    "engines/",
    "rules/",
    "analyze.py",
    "scanner.py",
    "explainer.py",
    "report.py",
    "requirements.txt",
    "README.md",
    "!**/__pycache__",
    "!**/*.pyc"
  ],
  "scripts": {
    "doctor": "node bin/safeship.js doctor"
  }
}
